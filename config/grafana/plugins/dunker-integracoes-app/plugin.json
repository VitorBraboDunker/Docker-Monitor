      "defaultNav": true,
      "role": "Viewer"
    },
    {
      "type": "page",
      "name": "Firewalls e SNMP",
      "path": "/a/dunker-integracoes-app/snmp",
      "addToNav": true,
      "defaultNav": false,
      "role": "Viewer"
    },
    {
      "type": "page",
      "name": "SharePoint",
      "path": "/a/dunker-integracoes-app/sharepoint",
      "addToNav": true,
      "defaultNav": false,
      "role": "Viewer"
    },
    {
      "type": "page",
      "name": "Servidores e histórico",
      "path": "/a/dunker-integracoes-app/servidores",
      "addToNav": true,

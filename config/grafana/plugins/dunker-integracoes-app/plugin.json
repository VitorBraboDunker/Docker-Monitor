    "keywords": [
      "sharepoint",
      "monitoramento",
      "dunker"
    ],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "version": "1.0.1",
    "updated": "2026-10-06"
  },
  "dependencies": {
    "grafanaDependency": ">=11.0.0",
    "plugins": []
  },
  "includes": [
    {

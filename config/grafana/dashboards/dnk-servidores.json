{
  "uid": "dnk-servidores",
  "title": "Dunker | Servidores",
  "schemaVersion": 39,
  "version": 1,
  "style": "dark",
  "tags": [
    "Dunker"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "Cliente",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "dnk-prometheus"
        },
        "query": "label_values(dnk_target_expected, Cliente)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "Unidade",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "dnk-prometheus"
        },
        "query": "label_values(dnk_target_expected{Cliente=~\"$Cliente\"}, Unidade)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "Dunker"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "title": "Painéis Dunker"
    },
    {
      "title": "Cadastrar IPs / Pings",
      "type": "link",
      "url": "/a/dunker-integracoes-app/links",
      "targetBlank": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Saúde dos servidores",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "dnk-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dnk:target_health{Cliente=~\"$Cliente\",Unidade=~\"$Unidade\",tipo=~\"windows|linux\"}",
          "legendFormat": "{{Cliente}} • {{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem dados",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#8794AA",
                "value": 1
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green"
                },
                "1": {
                  "text": "SEM DADOS",
                  "color": "#8794AA"
                },
                "2": {
                  "text": "ATENÇÃO",
                  "color": "yellow"
                },
                "3": {
                  "text": "CRÍTICO",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dnk-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dnk:cpu_percent{Cliente=~\"$Cliente\",Unidade=~\"$Unidade\"}",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Memória utilizada",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dnk-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dnk:memory_percent{Cliente=~\"$Cliente\",Unidade=~\"$Unidade\"}",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Espaço livre por volume",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dnk-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dnk:disk_free_percent{Cliente=~\"$Cliente\",Unidade=~\"$Unidade\"}",
          "legendFormat": "{{instance}} • {{volume}} {{mountpoint}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}

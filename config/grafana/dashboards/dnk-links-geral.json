    {
      "id": 8,
      "title": "Estado dos links",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 14
      },
      "description": "Uma série por verificação, sem agrupamento por cliente ou por IP. Cada cartão informa cliente, nome da verificação, unidade, provedor e destino. O clique usa o identificador exclusivo do link e abre seus detalhes.",
      "datasource": {
        "type": "prometheus",
        "uid": "dnk-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dnk-prometheus"
          },
          "refId": "A",
          "expr": "dnk:link_state{Cliente=~\"$Cliente\",Unidade=~\"$Unidade\",Provedor=~\"$Provedor\"}",
          "legendFormat": "{{Cliente}} · {{link_label}}",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "SEM DADOS",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#56A64B",
                "value": null
              },
              {
                "color": "#8794AA",
                "value": 1
              },
              {
                "color": "#F2CC0C",
                "value": 2
              },
              {
                "color": "#E02F44",
                "value": 3
              },
              {
                "color": "#A352CC",
                "value": 4
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "#56A64B",
                  "index": 0
                },
                "1": {
                  "text": "SEM DADOS",
                  "color": "#8794AA",
                  "index": 1
                },
                "2": {
                  "text": "ATENÇÃO",
                  "color": "#F2CC0C",
                  "index": 2
                },
                "3": {
                  "text": "GRAVE",
                  "color": "#E02F44",
                  "index": 3
                },
                "4": {
                  "text": "CRÍTICO",
                  "color": "#A352CC",
                  "index": 4
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "SEM DADOS",
                  "color": "#8794AA"
                }
              }
            }
          ],
          "links": [
            {
              "title": "Abrir detalhes deste link",
              "url": "/d/dnk-links/cliente?var-Cliente=${__field.labels.Cliente:percentencode}&var-Unidade=${__field.labels.Unidade:percentencode}&var-Link=${__field.labels.link_key:percentencode}&${__url_time_range}",
              "targetBlank": false,
              "oneClick": true
            }
          ]
        },
        "overrides": []

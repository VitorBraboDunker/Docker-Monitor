    {
      "id": 155,
      "type": "stat",
      "title": "Domínios e certificados",
      "datasource": {
        "type": "prometheus",
        "uid": "dnk-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#299c46",
                "value": null
              },
              {
                "color": "#8e959f",
                "value": 1
              },
              {
                "color": "#f2cc0c",
                "value": 2
              },
              {
                "color": "#e02f44",
                "value": 3
              },
              {
                "color": "#a64dd8",
                "value": 4
              },
              {
                "color": "#000000",
                "value": 5
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "#299c46",
                  "index": 0
                },
                "1": {
                  "text": "Sem Dados",
                  "color": "#8e959f",
                  "index": 1
                },
                "2": {
                  "text": "Atenção",
                  "color": "#f2cc0c",
                  "index": 2
                },
                "3": {
                  "text": "Grave",
                  "color": "#e02f44",
                  "index": 3
                },
                "4": {
                  "text": "Crítico",
                  "color": "#a64dd8",
                  "index": 4
                },
                "5": {
                  "text": "Pausado",
                  "color": "#000000",
                  "index": 5
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Sem Dados",
                  "color": "#8e959f"
                }
              }
            }
          ],
          "noValue": "Sem Dados"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "dnk_domain_status",
          "refId": "A",
          "legendFormat": "{{name}} · {{host}}",
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",

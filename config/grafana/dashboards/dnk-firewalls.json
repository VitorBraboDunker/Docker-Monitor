{
  "uid": "dnk-firewalls",
  "title": "Dunker | Firewalls e roteadores",
  "schemaVersion": 39,
  "version": 1,
  "style": "dark",
  "tags": [
    "Dunker"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "Cliente",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "dnk-prometheus"
        },
        "query": "label_values(dnk_target_expected, Cliente)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "Unidade",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "dnk-prometheus"
        },
        "query": "label_values(dnk_target_expected{Cliente=~\"$Cliente\"}, Unidade)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "Dunker"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "title": "Painéis Dunker"
    },
    {
      "title": "Cadastrar IPs / Pings",
      "type": "link",
      "url": "/monitoramento/",
      "targetBlank": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Entrada por interface (64 bits)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dnk-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ifHCInOctets{Cliente=~\"$Cliente\",Unidade=~\"$Unidade\"}[5m]) * 8",
          "legendFormat": "{{instance}} • {{ifName}} {{ifDescr}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Saída por interface (64 bits)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dnk-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ifHCOutOctets{Cliente=~\"$Cliente\",Unidade=~\"$Unidade\"}[5m]) * 8",
          "legendFormat": "{{instance}} • {{ifName}} {{ifDescr}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Erros de entrada por segundo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dnk-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ifInErrors{Cliente=~\"$Cliente\",Unidade=~\"$Unidade\"}[5m])",
          "legendFormat": "{{instance}} • {{ifName}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Descartes por segundo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dnk-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ifInDiscards{Cliente=~\"$Cliente\",Unidade=~\"$Unidade\"}[5m])",
          "legendFormat": "{{instance}} • {{ifName}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Coleta SNMP (1 = OK)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "dnk-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{Cliente=~\"$Cliente\",Unidade=~\"$Unidade\",job=\"snmp\"}",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "title": "Uptime SNMP",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "dnk-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sysUpTime{Cliente=~\"$Cliente\",Unidade=~\"$Unidade\"} / 100",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      }
    },

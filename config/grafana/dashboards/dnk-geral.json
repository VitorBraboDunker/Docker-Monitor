{
  "uid": "dnk-geral",
  "title": "Dunker | Visão geral",
  "schemaVersion": 39,
  "version": 1,
  "style": "dark",
  "tags": [
    "Dunker"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "Cliente",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "dnk-prometheus"
        },
        "query": "label_values(dnk_target_expected, Cliente)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "Unidade",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "dnk-prometheus"
        },
        "query": "label_values(dnk_target_expected{Cliente=~\"$Cliente\"}, Unidade)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "Dunker"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "title": "Painéis Dunker"
    },
    {
      "title": "Cadastrar IPs / Pings",
      "type": "link",
      "url": "/monitoramento/",
      "targetBlank": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Saúde por cliente",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "dnk-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (Cliente) (dnk:target_health{Cliente=~\"$Cliente\",Unidade=~\"$Unidade\"})",
          "legendFormat": "{{Cliente}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem dados",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#8794AA",
                "value": 1
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green"
                },
                "1": {
                  "text": "SEM DADOS",
                  "color": "#8794AA"
                },
                "2": {
                  "text": "ATENÇÃO",
                  "color": "yellow"
                },
                "3": {
                  "text": "CRÍTICO",
                  "color": "red"
                }
              }
            }
          ],
          "links": [
            {
              "title": "Links do cliente",
              "url": "/d/dnk-links?var-Cliente=${__field.labels.Cliente}&${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Alertas ativos",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "dnk-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (Cliente,severity) (ALERTS{alertstate=\"firing\",Cliente=~\"$Cliente\"})",
          "legendFormat": "{{Cliente}} • {{severity}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Alvos cadastrados",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "dnk-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (tipo) (dnk_target_expected{Cliente=~\"$Cliente\",Unidade=~\"$Unidade\"})",
          "legendFormat": "{{tipo}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Saúde por ativo",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "dnk-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dnk:target_health{Cliente=~\"$Cliente\",Unidade=~\"$Unidade\"}",
          "legendFormat": "{{Cliente}} • {{instance}} • {{tipo}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem dados",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#8794AA",
                "value": 1
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green"
                },
                "1": {
                  "text": "SEM DADOS",
                  "color": "#8794AA"
                },
                "2": {
                  "text": "ATENÇÃO",
                  "color": "yellow"
                },
                "3": {
                  "text": "CRÍTICO",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      }
    }
  ]
}

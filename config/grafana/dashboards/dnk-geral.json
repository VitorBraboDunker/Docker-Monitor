      "title": "",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 5
      },
      "description": "Pior estado dos links deste cliente. Clique para ver cada verificação separadamente.",
      "datasource": {
        "type": "prometheus",
        "uid": "dnk-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dnk-prometheus"
          },
          "refId": "A",
          "expr": "max by (Cliente) (dnk:link_state{Cliente=~\"$Cliente\",Unidade=~\"$Unidade\"})",
          "legendFormat": "{{Cliente}}",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "SEM DADOS",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#56A64B",
                "value": null
              },
              {
                "color": "#8794AA",
                "value": 1
              },
              {
                "color": "#F2CC0C",
                "value": 2
              },
              {
                "color": "#E02F44",
                "value": 3
              },
              {
                "color": "#A352CC",
                "value": 4
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "#56A64B",
                  "index": 0
                },
                "1": {
                  "text": "SEM DADOS",
                  "color": "#8794AA",
                  "index": 1
                },
                "2": {
                  "text": "ATENÇÃO",
                  "color": "#F2CC0C",
                  "index": 2
                },
                "3": {
                  "text": "GRAVE",
                  "color": "#E02F44",
                  "index": 3
                },
                "4": {
                  "text": "CRÍTICO",
                  "color": "#A352CC",
                  "index": 4
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "SEM DADOS",
                  "color": "#8794AA"
                }
              }
            }
          ],
          "displayName": "${Cliente:text}",
          "links": [
            {
              "title": "Abrir links de ${Cliente:text}",
              "url": "/d/dnk-links/cliente?var-Cliente=${Cliente:percentencode}&var-Unidade=All&var-Link=All&${__url_time_range}",
              "targetBlank": false,
              "oneClick": true
            }
          ]
        },
        "overrides": []
      },
